# This install's piano server, for the dev box's scripts (deploy, fresh install, the song skills).
# Copy it to ~/.config/piano-master/server.env (or point PIANO_CONFIG at your copy) and fill it in.
# Never commit your copy: the repo is public. A variable already set in the environment wins.

# The piano site's address, as the iPads open it (no trailing slash)
PIANO_SERVER=https://piano.example.lan

# The ssh host deploys use: an alias in ~/.ssh/config for the deploy account, which needs sudo
# with no password for rsync, rm, cp, chown, find, mv and piano-api-redeploy (docs/fresh-install.md)
PIANO_HOST=piano-server

# The root certificate of the server's own certificate authority (Caddy `tls internal`)
CADDY_ROOT_CA=~/.config/piano-master/server-root-ca.crt
