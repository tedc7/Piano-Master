# local tools (tools/setup.sh rebuilds them)
.tools/
tools/.venv/
tools/.vendor/
__pycache__/
# client build and generated content (tools/build_content.py)
client/node_modules/
client/dist/
client/public/content/
client/public/media/
tests-output/
# the content bundled into the API at deploy (tools/deploy.sh)
api/app/content/
# the media skill's tools (tools/media/setup.sh) and its work files
tools/.media/
# stems made by the media skill (arch §10.5): regenerated, not versioned
content/media/
# song batches being made (the import skill): sources, drafts and stems, some for private family
# use only. Approved songs reach git through content/pieces/ and content/library/, never from here
content/incoming/
# the family's method-book photos: never committed
Background/
# the family's own method-book page references (content/private/book-refs.yaml): never committed
content/private/
# every song built for the library (tools/build_content.py): submitted or seeded, never deployed
/build/
